# API groupegenetics-api (formulaire de contact, connexion et création de compte)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Tableau de bord administrateur (groupegenetics-admin) : les admins y sont redirigés après connexion
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000

# URL publique du site (balises de partage)
NEXT_PUBLIC_SITE_URL=https://www.groupegenetics.com

# Port exposé sur la machine hôte (3001 pour ne pas entrer en conflit avec l'admin sur 3000)
FRONT_PORT=3001
