# Lien "Support" du menu : page de connexion de groupegenetics-admin
NEXT_PUBLIC_SUPPORT_URL=http://localhost:3000/login

# API groupegenetics-api (formulaire de contact -> POST /contact/send-email)
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL publique du site (balises de partage)
NEXT_PUBLIC_SITE_URL=https://www.groupegenetics.com

# Port exposé sur la machine hôte (3001 pour ne pas entrer en conflit avec l'admin sur 3000)
FRONT_PORT=3001
